From 80111e4b8bd7fd1f432fe31c2295f5c399a5a900 Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Wed, 12 Jun 2024 11:11:08 +0200
Subject: [PATCH 1/3] autoboot: propagate boot index

tf-a reads active_index from metadata, and write it into
backup register.
fwu_plat_get_bootidx() function reads it to load bootcmd or
altbootcmd.
---
 common/autoboot.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/common/autoboot.c b/common/autoboot.c
index 5d331991c19..970706af20f 100644
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -447,6 +447,7 @@ const char *bootdelay_process(void)
 {
 	char *s;
 	int bootdelay;
+	u32 boot_idx;
 
 	bootcount_inc();
 
@@ -472,7 +473,8 @@ const char *bootdelay_process(void)
 		s = env_get("failbootcmd");
 	} else
 #endif /* CONFIG_POST */
-	if (bootcount_error())
+	fwu_plat_get_bootidx(&boot_idx);
+	if (boot_idx)
 		s = env_get("altbootcmd");
 	else
 		s = env_get("bootcmd");
-- 
