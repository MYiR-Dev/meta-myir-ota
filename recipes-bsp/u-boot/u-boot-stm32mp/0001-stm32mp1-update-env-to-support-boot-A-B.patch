From c0305b5775b4b6367744308f750dd8d5c9978dc1 Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Thu, 5 Oct 2023 11:09:11 +0200
Subject: [PATCH] stm32mp1: update env to support boot A/B

Patch to be reworked to avoid modifications in config_distro_bootcmd.h
---
 configs/stm32mp13_defconfig         | 2 +-
 configs/stm32mp15_defconfig         | 2 +-
 configs/stm32mp15_trusted_defconfig | 2 +-
 include/config_distro_bootcmd.h     | 1 +
 include/configs/stm32mp13_common.h  | 1 +
 include/configs/stm32mp15_common.h  | 1 +
 6 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/configs/stm32mp13_defconfig b/configs/stm32mp13_defconfig
index 16c8b09a84..2ce9e555d9 100644
--- a/configs/stm32mp13_defconfig
+++ b/configs/stm32mp13_defconfig
@@ -20,7 +20,7 @@ CONFIG_DISTRO_DEFAULTS=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0xc0400000
 CONFIG_FIT=y
 CONFIG_BOOTDELAY=1
-CONFIG_BOOTCOMMAND="run bootcmd_stm32mp"
+CONFIG_BOOTCOMMAND="echo 'Boot A';setenv altboot 0;run bootcmd_stm32mp"
 CONFIG_FDT_SIMPLEFB=y
 CONFIG_USB_HUB_DEBOUNCE_TIMEOUT=2000
 CONFIG_SYS_BOOTM_LEN=0x2000000
diff --git a/configs/stm32mp15_defconfig b/configs/stm32mp15_defconfig
index 67f9751ef8..a2471597ea 100644
--- a/configs/stm32mp15_defconfig
+++ b/configs/stm32mp15_defconfig
@@ -19,7 +19,7 @@ CONFIG_DISTRO_DEFAULTS=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0xc0100000
 CONFIG_FIT=y
 CONFIG_BOOTDELAY=1
-CONFIG_BOOTCOMMAND="run bootcmd_stm32mp"
+CONFIG_BOOTCOMMAND="echo 'Boot A';setenv altboot 0;run bootcmd_stm32mp"
 CONFIG_FDT_SIMPLEFB=y
 CONFIG_USB_HUB_DEBOUNCE_TIMEOUT=2000
 CONFIG_SYS_PBSIZE=1050
diff --git a/configs/stm32mp15_trusted_defconfig b/configs/stm32mp15_trusted_defconfig
index eeb1f3413a..80e409b043 100644
--- a/configs/stm32mp15_trusted_defconfig
+++ b/configs/stm32mp15_trusted_defconfig
@@ -20,7 +20,7 @@ CONFIG_DISTRO_DEFAULTS=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0xc0100000
 CONFIG_FIT=y
 CONFIG_BOOTDELAY=1
-CONFIG_BOOTCOMMAND="run bootcmd_stm32mp"
+CONFIG_BOOTCOMMAND="echo 'Boot A';setenv altboot 0;run bootcmd_stm32mp"
 CONFIG_FDT_SIMPLEFB=y
 CONFIG_USB_HUB_DEBOUNCE_TIMEOUT=2000
 CONFIG_SYS_PBSIZE=1050
diff --git a/include/config_distro_bootcmd.h b/include/config_distro_bootcmd.h
index 5506f3168f..6a3d8f905a 100644
--- a/include/config_distro_bootcmd.h
+++ b/include/config_distro_bootcmd.h
@@ -487,6 +487,7 @@
 		"part list ${devtype} ${devnum} -bootable devplist; "     \
 		"env exists devplist || setenv devplist 1; "              \
 		"for distro_bootpart in ${devplist}; do "                 \
+		"if test ${altboot} = 1;then setexpr distro_bootpart ${distro_bootpart} + 1; fi;" \
 			"if fstype ${devtype} "                           \
 					"${devnum}:${distro_bootpart} "   \
 					"bootfstype; then "               \
diff --git a/include/configs/stm32mp13_common.h b/include/configs/stm32mp13_common.h
index d561bc2d31..df36147fd0 100644
--- a/include/configs/stm32mp13_common.h
+++ b/include/configs/stm32mp13_common.h
@@ -93,6 +93,7 @@
 
 #define STM32MP_EXTRA \
 	"env_check=if env info -p -d -q; then env save; fi\0" \
+	"altbootcmd=echo 'Boot B';setenv altboot 1;run bootcmd_stm32mp\0" \
 	"boot_net_usb_start=true\0"
 
 #ifndef STM32MP_BOARD_EXTRA_ENV
diff --git a/include/configs/stm32mp15_common.h b/include/configs/stm32mp15_common.h
index 98d83be852..c836b8fb5b 100644
--- a/include/configs/stm32mp15_common.h
+++ b/include/configs/stm32mp15_common.h
@@ -97,6 +97,7 @@
 
 #define STM32MP_EXTRA \
 	"env_check=if env info -p -d -q; then env save; fi\0" \
+	"altbootcmd=echo 'Boot B';setenv altboot 1;run bootcmd_stm32mp\0" \
 	"boot_net_usb_start=true\0"
 
 #ifndef STM32MP_BOARD_EXTRA_ENV
-- 
2.25.1

