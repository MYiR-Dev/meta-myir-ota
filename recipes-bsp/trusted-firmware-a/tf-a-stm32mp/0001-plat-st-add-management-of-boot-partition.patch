From f2992b78429468b5f8ceebb442d15d29dfe75aeb Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Tue, 10 Oct 2023 17:03:37 +0200
Subject: [PATCH 1/2] plat/st: add management of boot partition

Give next stage boot the boot mode used (0 for normal boot,
2 for recovery).
---
 plat/st/common/bl2_io_storage.c         |  1 +
 plat/st/common/include/stm32mp_common.h |  7 +++++++
 plat/st/stm32mp1/stm32mp1_private.c     | 16 ++++++++++++++++
 3 files changed, 24 insertions(+)

diff --git a/plat/st/common/bl2_io_storage.c b/plat/st/common/bl2_io_storage.c
index af9df4132..31d237e96 100644
--- a/plat/st/common/bl2_io_storage.c
+++ b/plat/st/common/bl2_io_storage.c
@@ -738,6 +738,7 @@ uint32_t plat_fwu_get_boot_idx(void)
 
 	if (boot_idx == INVALID_BOOT_IDX) {
 		boot_idx = data->active_index;
+		stm32_set_bkpr_boot_mode_addr((boot_idx == 1U) ? BOOT_RECOVERY : BOOT_NORMAL);
 		if (fwu_is_trial_run_state()) {
 			if (stm32_get_and_dec_fwu_trial_boot_cnt() == 0U) {
 				WARN("Trial FWU fails %u times\n",
diff --git a/plat/st/common/include/stm32mp_common.h b/plat/st/common/include/stm32mp_common.h
index 56380f8d3..786022a89 100644
--- a/plat/st/common/include/stm32mp_common.h
+++ b/plat/st/common/include/stm32mp_common.h
@@ -20,6 +20,11 @@
 /* FWU configuration (max supported value is 15) */
 #define FWU_MAX_TRIAL_REBOOT		U(3)
 
+enum boot_mode {
+        BOOT_NORMAL = 0x00,
+        BOOT_RECOVERY = 0x02,
+};
+
 /* Functions to save and get boot context address given by ROM code */
 void stm32mp_save_boot_ctx_address(uintptr_t address);
 uintptr_t stm32mp_get_boot_ctx_address(void);
@@ -151,6 +156,8 @@ void stm32_save_boot_info(boot_api_context_t *boot_context);
 void stm32_get_boot_interface(uint32_t *interface, uint32_t *instance);
 /* Function to get BOOT_MODE backup register address */
 uintptr_t stm32_get_bkpr_boot_mode_addr(void);
+/* Function to set BOOT_MODE backup register address */
+int stm32_set_bkpr_boot_mode_addr(enum boot_mode mode);
 
 /* Display board information from the value found in OTP fuse */
 void stm32_display_board_info(uint32_t board_id);
diff --git a/plat/st/stm32mp1/stm32mp1_private.c b/plat/st/stm32mp1/stm32mp1_private.c
index cd4b47ad1..16f53ad2d 100644
--- a/plat/st/stm32mp1/stm32mp1_private.c
+++ b/plat/st/stm32mp1/stm32mp1_private.c
@@ -30,6 +30,9 @@
  */
 #define TAMP_BOOT_FWU_INFO_REG_ID	U(10)
 
+#define TAMP_BOOT_MODE_MASK		GENMASK_32(7, 0)
+#define TAMP_BOOT_MODE_SHIFT		0
+
 #if defined(IMAGE_BL2)
 #define MAP_SEC_SYSRAM	MAP_REGION_FLAT(STM32MP_SYSRAM_BASE, \
 					STM32MP_SYSRAM_SIZE, \
@@ -728,6 +731,19 @@ uintptr_t stm32_get_bkpr_boot_mode_addr(void)
 }
 
 #if PSA_FWU_SUPPORT
+
+int stm32_set_bkpr_boot_mode_addr(enum boot_mode mode)
+{
+	clk_enable(RTCAPB);
+
+	mmio_clrsetbits_32(stm32_get_bkpr_boot_mode_addr(),
+			   TAMP_BOOT_MODE_MASK,
+			   mode << TAMP_BOOT_MODE_SHIFT);
+
+	clk_disable(RTCAPB);
+	return 0;
+}
+
 uintptr_t stm32_get_bkpr_fwu_info_addr(void)
 {
 	return tamp_bkpr(TAMP_BOOT_FWU_INFO_REG_ID);
-- 
2.25.1

