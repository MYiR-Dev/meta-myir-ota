From 6de9af14cc9c8eef5a9c71dafd4f76fa9cd38373 Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Fri, 6 Dec 2024 14:06:45 +0100
Subject: [PATCH] add logs for demo purpose

Change-Id: I508227b0ef372d148eaa1b7132ed1b708410ecb6
---
 plat/st/common/bl2_io_storage.c | 5 ++++-
 plat/st/common/stm32mp_common.c | 1 +
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/plat/st/common/bl2_io_storage.c b/plat/st/common/bl2_io_storage.c
index 1a6395d5f3..762ea89a44 100644
--- a/plat/st/common/bl2_io_storage.c
+++ b/plat/st/common/bl2_io_storage.c
@@ -801,12 +801,15 @@ uint32_t plat_fwu_get_boot_idx(void)
 
 		boot_idx = data->active_index;
 
+		NOTICE("!!CGU : active index: %u, bank state: %d\n", boot_idx, data->bank_state[boot_idx]);
 		switch (data->bank_state[boot_idx]) {
 		case FWU_BANK_STATE_ACCEPTED:
+			NOTICE("!! CGU: bank is accepted\n");
 			stm32_set_max_fwu_trial_boot_cnt();
 			break;
 		case FWU_BANK_STATE_VALID:
 			bootcount = stm32_get_and_dec_fwu_trial_boot_cnt();
+			NOTICE("!! CGU: bank is in trial mode, bootcount=%u\n", bootcount);
 			if (bootcount == 1U) {
 				WARN("Trial FWU fails %u times\n",
 				     (FWU_MAX_TRIAL_REBOOT - 1U));
@@ -858,7 +861,7 @@ void plat_fwu_set_images_source(const struct fwu_metadata *metadata)
 
 	boot_idx = plat_fwu_get_boot_idx();
 	assert(boot_idx < NR_OF_FW_BANKS);
-	VERBOSE("Selecting to boot from bank %u\n", boot_idx);
+	NOTICE("Selecting to boot from bank %u\n", boot_idx);
 
 	img_entry = (void *)&metadata->fw_desc.img_entry;
 	for (i = 0U; i < NR_OF_IMAGES_IN_FW_BANK; i++) {
diff --git a/plat/st/common/stm32mp_common.c b/plat/st/common/stm32mp_common.c
index b924dc00f8..35b7801589 100644
--- a/plat/st/common/stm32mp_common.c
+++ b/plat/st/common/stm32mp_common.c
@@ -648,6 +648,7 @@ uint32_t stm32_get_and_dec_fwu_trial_boot_cnt(void)
 					(try_cnt - 1U) << FWU_INFO_CNT_OFF);
 	}
 
+	NOTICE("!!CGU : fwu bootcount %lu\n", (unsigned long)try_cnt);
 	return try_cnt;
 }
 
-- 
2.34.1

