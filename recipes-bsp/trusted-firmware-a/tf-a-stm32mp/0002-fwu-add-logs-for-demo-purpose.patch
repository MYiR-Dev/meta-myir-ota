From 6cd341b60f816e3e1b3aab1d739e4046b515668b Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Thu, 5 Oct 2023 15:11:35 +0200
Subject: [PATCH 2/2] fwu: add logs for demo purpose

# Conflicts:
#	plat/st/common/bl2_io_storage.c
---
 plat/st/common/bl2_io_storage.c | 1 +
 plat/st/common/stm32mp_common.c | 1 +
 2 files changed, 2 insertions(+)

diff --git a/plat/st/common/bl2_io_storage.c b/plat/st/common/bl2_io_storage.c
index 31d237e96..4dc872c28 100644
--- a/plat/st/common/bl2_io_storage.c
+++ b/plat/st/common/bl2_io_storage.c
@@ -776,6 +776,7 @@ void plat_fwu_set_images_source(const struct fwu_metadata *metadata)
 	io_block_spec_t *image_spec;
 
 	boot_idx = plat_fwu_get_boot_idx();
+	INFO("fwu active_index is %u\n", boot_idx);
 	assert(boot_idx < NR_OF_FW_BANKS);
 
 	for (i = 0U; i < NR_OF_IMAGES_IN_FW_BANK; i++) {
diff --git a/plat/st/common/stm32mp_common.c b/plat/st/common/stm32mp_common.c
index d418608aa..21ddba4e3 100644
--- a/plat/st/common/stm32mp_common.c
+++ b/plat/st/common/stm32mp_common.c
@@ -496,6 +496,7 @@ uint32_t stm32_get_and_dec_fwu_trial_boot_cnt(void)
 	}
 	clk_disable(TAMP_BKP_REG_CLK);
 
+	INFO("fwu bootcount %u\n", try_cnt);
 	return try_cnt;
 }
 
